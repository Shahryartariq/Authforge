# ─── Required ────────────────────────────────────────────────────────────────

# Any Postgres database. Neon's free tier works well on Vercel.
DATABASE_URL=postgres://user:password@localhost:5432/authforge

# 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. On Vercel this falls back to the production domain.
BETTER_AUTH_URL=http://localhost:3000

# ─── Admins ──────────────────────────────────────────────────────────────────

# Comma-separated. These emails get the admin role when they sign up.
ADMIN_EMAILS=

# ─── Email (optional in development) ────────────────────────────────────────

# Without a key, verification and reset emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Authforge <onboarding@resend.dev>"

# ─── Social sign-in (optional) ──────────────────────────────────────────────
# A provider shows up only when both its ID and secret are set.

# https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://github.com/settings/developers
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Security ────────────────────────────────────────────────────────────────

# Rejects passwords found in known breaches (k-anonymity, the password never leaves your server).
# Set to false only for offline environments.
PWNED_PASSWORD_CHECK=true
